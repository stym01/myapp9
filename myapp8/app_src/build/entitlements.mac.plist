<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    macOS entitlements for Solvro.

    These only take effect when the app is code-signed (which needs an Apple
    Developer ID). The current build is distributed unsigned (see build.mac
    "identity": null in package.json), so these are inert today and are kept
    here so that enabling signing + notarization later is a one-line change.

    The runtime permission PROMPTS that users actually see are driven by the
    Info.plist usage strings in package.json -> build.mac.extendInfo, which work
    regardless of signing.
  -->

  <!-- Electron/Chromium runs a JIT; required under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Load our native modules (node-global-key-listener ships a helper binary). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Microphone: interview-mode speech transcription. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Camera key is included defensively for getUserMedia code paths. -->
  <key>com.apple.security.device.camera</key>
  <true/>

  <!-- Drive System Events via osascript for the auto-type feature. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
